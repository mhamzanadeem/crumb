# Copy to .env.local. Never commit actual credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=crumb
# Optional, Node-process-only workaround for DNS SRV errors. Leave blank when system DNS works.
MONGODB_DNS_SERVERS=
# Optional: https for networks blocking native SRV/TXT lookups; blank uses native DNS.
# Sends public Atlas hostname queries (never credentials) to Google DNS over HTTPS.
MONGODB_DNS_TRANSPORT=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=owner@example.com
# At least 12 characters; used only for this single bakery owner's login.
ADMIN_PASSWORD=replace-with-a-strong-password
APP_URL=http://localhost:3000

# PayPal sandbox only. Catalog PKR prices are NOT converted to USD.
# APIMatic-generated PayPal SDK is installed and is the default transport.
PAYPAL_TRANSPORT=apimatic
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Only enable for a dedicated disposable sandbox buyer. These are public in demo UI.
SHOW_SANDBOX_BUYER_CREDENTIALS=false
SANDBOX_UNIT_PRICE_USD=12.00

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_DAILY_REQUEST_LIMIT=100

# Public evaluation/demo can only touch its isolated demo workspace.
DEMO_ENABLED=true
# Optional LOCAL ONLY in-memory storage when MongoDB isn't configured.
# Disabled in production, even when true. Data disappears on restart.
ALLOW_MEMORY_DB=false

# AG Studio is a commercial component. Use your trial/license for deployment.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# Optional merchant uploads. Bundled photos do not require Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
