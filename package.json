{
  "name": "crumb-order-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "setup:apimatic-sdk": "npm install --save-exact @paypal/paypal-server-sdk@2.5.0",
    "setup:apimatic-context": "npx --yes context-plugins install paypal --targets codex --yes",
    "paypal:check": "node --env-file=.env.local lib/cli/paypal-check.js",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "seed": "node --env-file=.env.local lib/cli/seed.js",
    "db:check": "node --env-file=.env.local lib/cli/db-check.js"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "2.5.0",
    "ag-studio": "^3.1.0",
    "ag-studio-react": "^3.1.0",
    "jose": "^6.1.0",
    "mongodb": "^6.21.0",
    "next": "^16.0.0",
    "openai": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
